// Copy this file to secrets.h (git-ignored) and fill in the real passwords.
#pragma once

struct WifiNet {
  const char* label;     // name shown on the Core2 display
  const char* ssid;      // must match the broadcast name exactly (case-sensitive)
  const char* password;
};

// Order here is the order of the status bars on screen.
static const WifiNet WIFI_NETS[] = {
  {"Ghorman",  "Ghorman",      "CHANGE_ME"},  // Quantum Fiber
  {"Naboo",    "Naboo",        "CHANGE_ME"},  // T-Mobile fixed wireless (what the IoT devices use)
  {"T-Mobile", "TMOBILE-C988", "CHANGE_ME"},  // T-Mobile gateway direct (password is on the gateway label)
};

static const int WIFI_NET_COUNT = sizeof(WIFI_NETS) / sizeof(WIFI_NETS[0]);

// Heartbeat listener on the Debian TinyPC (see osprey/). Sent while connected to Ghorman.
// The token must match M5CORE2_TOKEN in the listener's .env file.
static const char* const HEARTBEAT_HOST  = "192.168.0.x";
static const int         HEARTBEAT_PORT  = 9099;
static const char* const HEARTBEAT_TOKEN = "CHANGE_ME";
